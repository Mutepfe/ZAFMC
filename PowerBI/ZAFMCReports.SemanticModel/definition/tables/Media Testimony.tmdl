table 'Media Testimony'

	measure 'Testimony Count' = COUNTROWS('Media Testimony')
		formatString: #,0

	column Testifier
		dataType: string
		summarizeBy: none
		sourceColumn: TestmTestifier

	column Date
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: TestmDate

		annotation UnderlyingDateTimeDataType = Date

	column 'Testimony File'
		dataType: string
		summarizeBy: none
		sourceColumn: TestmFile

	partition 'Media Testimony' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "MediaTestimony"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"TestmTestifier", "TestmDate", "TestmFile"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
