table Youth

	measure 'Youth Event Count' = COUNTROWS('Youth')
		formatString: #,0

	column Venue
		dataType: string
		summarizeBy: none
		sourceColumn: YouthVenue

	column Leader
		dataType: string
		summarizeBy: none
		sourceColumn: YouthLeader

	column Duration
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: YouthDuration

	column Date
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: YouthDate

		annotation UnderlyingDateTimeDataType = Date

	partition Youth = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "PassYouth"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"YouthVenue", "YouthLeader", "YouthDuration", "YouthDate"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
