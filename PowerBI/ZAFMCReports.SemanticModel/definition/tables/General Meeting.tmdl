table 'General Meeting'

	measure 'General Meeting Count' = COUNTROWS('General Meeting')
		formatString: #,0

	column Date
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: GeneralDate

		annotation UnderlyingDateTimeDataType = Date

	column Description
		dataType: string
		summarizeBy: none
		sourceColumn: GeneralDescription

	column Venue
		dataType: string
		summarizeBy: none
		sourceColumn: GeneralVenue

	column Leader
		dataType: string
		summarizeBy: none
		sourceColumn: GeneralLeader

	column Duration
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: GeneralDuration

	partition 'General Meeting' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "PassGeneralMeeting"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"GeneralDate", "GeneralDescription", "GeneralVenue", "GeneralLeader", "GeneralDuration"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
