table Wedding

	measure 'Wedding Count' = COUNTROWS('Wedding')
		formatString: #,0

	column Date
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: WeddingDate

		annotation UnderlyingDateTimeDataType = Date

	column Venue
		dataType: string
		summarizeBy: none
		sourceColumn: Venue

	column Bride
		dataType: string
		summarizeBy: none
		sourceColumn: Bride

	column 'Bride Mobile'
		dataType: string
		summarizeBy: none
		sourceColumn: BrideMobile

	column Groom
		dataType: string
		summarizeBy: none
		sourceColumn: Groom

	column 'Groom Mobile'
		dataType: string
		summarizeBy: none
		sourceColumn: GroomMobile

	column 'Marriage Officer'
		dataType: string
		summarizeBy: none
		sourceColumn: MarriageOfficer

	column Leader
		dataType: string
		summarizeBy: none
		sourceColumn: ChurchLeader

	column 'Leader Mobile'
		dataType: string
		summarizeBy: none
		sourceColumn: LeaderMobile

	partition Wedding = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "PassWedding"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"WeddingDate", "Venue", "Bride", "BrideMobile", "Groom", "GroomMobile", "MarriageOfficer", "ChurchLeader", "LeaderMobile"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
