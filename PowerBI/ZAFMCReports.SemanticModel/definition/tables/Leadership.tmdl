table Leadership

	measure 'Leader Count' = COUNTROWS('Leadership')
		formatString: #,0

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: LeaderName

	column Surname
		dataType: string
		summarizeBy: none
		sourceColumn: LeaderSurname

	column 'Date Of Birth'
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: LeaderDOB

		annotation UnderlyingDateTimeDataType = Date

	column 'Passport ID'
		dataType: string
		summarizeBy: none
		sourceColumn: LeaderIdentity

	column Position
		dataType: string
		summarizeBy: none
		sourceColumn: LeaderPosition

	partition Leadership = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "AboutLeadership"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"LeaderName", "LeaderSurname", "LeaderDOB", "LeaderIdentity", "LeaderPosition"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
