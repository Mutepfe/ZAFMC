table Passover

	measure 'Passover Count' = COUNTROWS('Passover')
		formatString: #,0

	column Date
		dataType: dateTime
		formatString: d MMM yyyy
		summarizeBy: none
		sourceColumn: PassoverDate

		annotation UnderlyingDateTimeDataType = Date

	column Venue
		dataType: string
		summarizeBy: none
		sourceColumn: PassoverVenue

	column 'Venue Leader'
		dataType: string
		summarizeBy: none
		sourceColumn: PassoverVenueLeader

	column 'Leader Mobile'
		dataType: string
		summarizeBy: none
		sourceColumn: PassoverLeaderMobile

	partition Passover = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Navigation = Source{[Schema = "dbo", Item = "Passover"]}[Data],
				    Selected = Table.SelectColumns(Navigation, {"PassoverDate", "PassoverVenue", "PassoverVenueLeader", "PassoverLeaderMobile"})
				in
				    Selected

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
