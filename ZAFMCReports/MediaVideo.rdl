  <DataSets>
    <DataSet Name="MediaVideo">
      <Query>
        <DataSourceName>ZAFMCMediaVideo</DataSourceName>
        <CommandText>SELECT        VideoName, VideoOccassion, VideoDate, VideoFile
FROM            MediaVideo</CommandText>
      </Query>
      <Fields>
        <Field Name="VideoName">
          <DataField>VideoName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VideoOccassion">
          <DataField>VideoOccassion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VideoDate">
          <DataField>VideoDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="VideoFile">
          <DataField>VideoFile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!VideoName.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!VideoNames.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!VideoOccassion.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Occassions.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!VideoDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!VideoDate.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Name">
      <Query>
        <DataSourceName>ZAFMCMediaVideo</DataSourceName>
        <CommandText>SELECT DISTINCT    [VideoName]    FROM          [MediaVideo]</CommandText>
      </Query>
      <Fields>
        <Field Name="VideoName">
          <DataField>VideoName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Occassion">
      <Query>
        <DataSourceName>ZAFMCMediaVideo</DataSourceName>
        <CommandText>SELECT DISTINCT    [VideoOccassion]   FROM     [MediaVideo]   </CommandText>
      </Query>
      <Fields>
        <Field Name="VideoOccassion">
          <DataField>VideoOccassion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Date">
      <Query>
        <DataSourceName>ZAFMCMediaVideo</DataSourceName>
        <CommandText>SELECT DISTINCT     [VideoDate]       FROM        [MediaVideo]</CommandText>
      </Query>
      <Fields>
        <Field Name="VideoDate">
          <DataField>VideoDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
