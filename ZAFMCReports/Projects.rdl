    <DataSet Name="Projects">
      <Query>
        <DataSourceName>ZAFMCProjects</DataSourceName>
        <CommandText>SELECT        ProjectName, ProjectStartDate, ProjectDuration, ProjectExpecDate, ProjectLeader, ProjectLeaderRank, ProjectSite, ProjectEstimCost, ProjectCompDate
FROM            Projects</CommandText>
      </Query>
