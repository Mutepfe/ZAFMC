          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!ProjectStartDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!StartDate.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
