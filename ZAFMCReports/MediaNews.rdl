  <DataSets>
    <DataSet Name="MediaNews">
      <Query>
        <DataSourceName>ZAFMCMediaNews</DataSourceName>
        <CommandText>SELECT        NewsName, NewsDate, NewsFile
FROM            MediaNews
ORDER BY NewsName</CommandText>
      </Query>
      <Fields>
        <Field Name="NewsName">
          <DataField>NewsName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NewsDate">
          <DataField>NewsDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NewsFile">
          <DataField>NewsFile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!NewsName.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Name.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!NewsDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!DateNews.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Name">
      <Query>
        <DataSourceName>ZAFMCMediaNews</DataSourceName>
        <CommandText>SELECT      DISTINCT   NewsName
FROM            MediaNews</CommandText>
      </Query>
      <Fields>
        <Field Name="NewsName">
          <DataField>NewsName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Date">
      <Query>
        <DataSourceName>ZAFMCMediaNews</DataSourceName>
        <CommandText>SELECT       DISTINCT NewsDate
FROM            MediaNews</CommandText>
      </Query>
      <Fields>
        <Field Name="NewsDate">
          <DataField>NewsDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
