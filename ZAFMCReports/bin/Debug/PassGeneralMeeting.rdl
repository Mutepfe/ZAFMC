        <DataSourceName>ZAFMCPassGenMeeting</DataSourceName>
        <CommandText>SELECT       DISTINCT           [GeneralVenue]      FROM         [PassGeneralMeeting]</CommandText>
      </Query>
      <Fields>
        <Field Name="GeneralVenue">
