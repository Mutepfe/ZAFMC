        </Field>
        <Field Name="GeneralVenue">
          <DataField>GeneralVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GeneralLeader">
          <DataField>GeneralLeader</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GeneralDuration">
          <DataField>GeneralDuration</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!GeneralVenue.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Venue.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!GeneralLeader.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Leader.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!GeneralDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Date.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Venue">
