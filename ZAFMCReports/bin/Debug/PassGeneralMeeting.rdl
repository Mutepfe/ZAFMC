  <DataSets>
    <DataSet Name="PassGenMeeting">
      <Query>
        <DataSourceName>ZAFMCPassGenMeeting</DataSourceName>
        <CommandText>SELECT        GeneralDate, GeneralDescription, GeneralVenue, GeneralLeader, GeneralDuration
FROM            PassGeneralMeeting</CommandText>
      </Query>
      <Fields>
        <Field Name="GeneralDate">
          <DataField>GeneralDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
