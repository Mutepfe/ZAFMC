  <DataSets>
    <DataSet Name="Passovers">
      <Query>
        <DataSourceName>ZAFMCPassovers</DataSourceName>
        <CommandText>SELECT        PassoverDate, PassoverVenue, PassoverVenueLeader, PassoverLeaderMobile
FROM            Passover</CommandText>
      </Query>
      <Fields>
        <Field Name="PassoverDate">
          <DataField>PassoverDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="PassoverVenue">
          <DataField>PassoverVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PassoverVenueLeader">
          <DataField>PassoverVenueLeader</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PassoverLeaderMobile">
          <DataField>PassoverLeaderMobile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!PassoverVenue.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Venue.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!PassoverDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Date.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Venue">
      <Query>
        <DataSourceName>ZAFMCPassovers</DataSourceName>
        <CommandText>SELECT       DISTINCT      [PassoverVenue]        FROM           [Passover]</CommandText>
      </Query>
      <Fields>
        <Field Name="PassoverVenue">
          <DataField>PassoverVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Date">
      <Query>
        <DataSourceName>ZAFMCPassovers</DataSourceName>
        <CommandText>SELECT     DISTINCT     [PassoverDate]    FROM     [Passover]</CommandText>
      </Query>
      <Fields>
        <Field Name="PassoverDate">
          <DataField>PassoverDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
