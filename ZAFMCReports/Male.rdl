        </QueryParameters>
        <CommandText>SELECT        CongMembershipNumber, CongTitle, CongName, CongSurname, CongDOB, CongGender, CongPassportID, CongStatus, CongProfession, CongKin, CongKinContact, CongCell, CongAddress, CongEmail, CongPosition, CongDateAppointed, CongManagerial, 
