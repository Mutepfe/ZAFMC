          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="YouthDate">
          <DataField>YouthDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!YouthLeader.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Leader.Value</FilterValue>
