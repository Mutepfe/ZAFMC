  <DataSets>
    <DataSet Name="Administration">
      <Query>
        <DataSourceName>AboutAdministration</DataSourceName>
        <CommandText>SELECT        AdminName, AdminSurname, AdminAppntDate, AdminInternComm, AdminInternDir
FROM            AboutAdministration</CommandText>
      </Query>
      <Fields>
        <Field Name="AdminName">
          <DataField>AdminName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdminSurname">
          <DataField>AdminSurname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdminAppntDate">
          <DataField>AdminAppntDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AdminInternComm">
          <DataField>AdminInternComm</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdminInternDir">
          <DataField>AdminInternDir</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!AdminName.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Name.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!AdminInternComm.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Committee.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!AdminInternDir.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Directors.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!AdminAppntDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Date.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Name">
      <Query>
        <DataSourceName>AboutAdministration</DataSourceName>
        <CommandText>SELECT            DISTINCT       [AdminName]        FROM         [AboutAdministration]</CommandText>
      </Query>
      <Fields>
