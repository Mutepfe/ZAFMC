  <DataSets>
    <DataSet Name="PassGraduation">
      <Query>
        <DataSourceName>ZAFMCPassGraduation</DataSourceName>
        <CommandText>SELECT        GraduationDate, GraduationVenue, GraduateName, GraduateMobile, GraduateDegree, GraduateLeader, GraduateLeaderMobile
FROM            PassGraduation</CommandText>
      </Query>
      <Fields>
        <Field Name="GraduationDate">
          <DataField>GraduationDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
