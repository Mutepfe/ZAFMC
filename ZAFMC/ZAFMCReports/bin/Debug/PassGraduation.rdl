          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GraduateName">
          <DataField>GraduateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GraduateMobile">
