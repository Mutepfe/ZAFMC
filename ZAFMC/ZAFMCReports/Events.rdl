  <DataSets>
    <DataSet Name="Events">
      <Query>
        <DataSourceName>ZAFMCEvents</DataSourceName>
        <CommandText>SELECT        EventName, EventDate, EventVenue, EventPerson, EventPersonCell, EventPersonEmail, EventDuration, EventStatus
FROM            Events</CommandText>
      </Query>
      <Fields>
        <Field Name="EventName">
          <DataField>EventName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EventDate">
          <DataField>EventDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EventVenue">
          <DataField>EventVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EventPerson">
          <DataField>EventPerson</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EventPersonCell">
          <DataField>EventPersonCell</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EventPersonEmail">
          <DataField>EventPersonEmail</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EventDuration">
          <DataField>EventDuration</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="EventStatus">
          <DataField>EventStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!EventName.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Name.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!EventDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Date.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!EventStatus.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Status.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!EventVenue.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Venue.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Name">
      <Query>
        <DataSourceName>ZAFMCEvents</DataSourceName>
        <CommandText>SELECT DISTINCT         [EventName]        FROM         [Events]</CommandText>
      </Query>
      <Fields>
        <Field Name="EventName">
          <DataField>EventName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Date">
      <Query>
        <DataSourceName>ZAFMCEvents</DataSourceName>
        <CommandText>SELECT DISTINCT            [EventDate]       FROM            [Events]          </CommandText>
      </Query>
      <Fields>
        <Field Name="EventDate">
          <DataField>EventDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Status">
      <Query>
        <DataSourceName>ZAFMCEvents</DataSourceName>
        <CommandText>SELECT DISTINCT      [EventStatus]    FROM         [Events]</CommandText>
      </Query>
      <Fields>
        <Field Name="EventStatus">
