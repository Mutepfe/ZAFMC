  <DataSets>
    <DataSet Name="PassMemorial">
      <Query>
        <DataSourceName>ZAFMCPassMemorial</DataSourceName>
        <CommandText>SELECT        MemorialDate, DeceasedName, MemorialVenue, ChurchLeader, RelativeMobile
FROM            PassMemorial</CommandText>
      </Query>
      <Fields>
        <Field Name="MemorialDate">
          <DataField>MemorialDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DeceasedName">
          <DataField>DeceasedName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MemorialVenue">
          <DataField>MemorialVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ChurchLeader">
          <DataField>ChurchLeader</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RelativeMobile">
          <DataField>RelativeMobile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!DeceasedName.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Name.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!MemorialVenue.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Venue.Value</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=Fields!MemorialDate.Value</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=Parameters!Date.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="DeceasedName">
      <Query>
        <DataSourceName>ZAFMCPassMemorial</DataSourceName>
        <CommandText>SELECT        DISTINCT          [DeceasedName]      FROM        [PassMemorial]</CommandText>
      </Query>
      <Fields>
        <Field Name="DeceasedName">
          <DataField>DeceasedName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MemorialVenue">
      <Query>
        <DataSourceName>ZAFMCPassMemorial</DataSourceName>
        <CommandText>SELECT              DISTINCT           [MemorialVenue]       FROM       [PassMemorial]</CommandText>
      </Query>
      <Fields>
        <Field Name="MemorialVenue">
          <DataField>MemorialVenue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Date">
