<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ZAFMC.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - ZAFMC</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <%-- CLOSE APPLICATION --%>
     <script type="text/javascript">
         function ExitZAFMC()
         {
             
             if (document.getElementById($('#Passovers')))
             {
                 self.parent.close();
             }
             else
                 self.parent.close();
             
         }

         

     </script>
</head>
<body>
    <form runat="server">
        <%-- SCRIPTS --%>
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="bootstrap" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
                <%-- Specifically in this Order Below --%>
                <asp:ScriptReference Path="~/Scripts/ScriptsClientSide/jquery-3.3.1.min.js" />
                <asp:ScriptReference Path="~/Scripts/ScriptsClientSide/jquery.validate.min.js" />
                <asp:ScriptReference Path="~/Scripts/ScriptsClientSide/jquery.validate.unobtrusive.min.js" />
                <%-- ClientSide Validation Scripts --%>

                <%-- Close ASP Forms --%>

                
                
            </Scripts>
         

        </asp:ScriptManager>

        <%-- NAVBAR --%>
        <div class="navbar navbar-inverse navbar-fixed-top" style="background-color: maroon;">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar" style="background-color: white;"></span>
                        <span class="icon-bar" style="background-color: white;"></span>
                        <span class="icon-bar" style="background-color: white;"></span>

                    </button>
                    <a class="navbar-brand" runat="server" href="~/"><strong>ZAFMC</strong></a>
                </div>
                <%-- APP MENUS  --%>
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav" style="text-decoration-color: white;">
                        <li><a runat="server" href="~/" id="Home">Home</a></li>
                        <li><a runat="server" href="~/Congregation" id="Congregation">Congregation</a></li>
                        <li><a runat="server" href="~/Churches" id="Churches">Churches</a></li>
                        <li><a runat="server" href="~/MediaCentre" id="Media">Media</a></li>
                        <li><a runat="server" href="~/EventsCentre" id="Events">Events</a></li>
                        <li><a runat="server" href="~/Passovers" id="Passovers">Passovers</a></li>
                        <li><a runat="server" href="~/Projects" id="Projects">Projects</a></li>
                        <li><a runat="server" href="~/Finance" id="Finance">Finance</a></li>
                        <li><a runat="server" href="~/Reports" id="Reports">Reports</a></li>
                        <li><a runat="server" href="~/About"  id="Contact">Contact</a></li>
                        <li><a runat="server" href="~/RegisterUser" visible="false">Register User</a></li>
                        <%--User Account(Logged)--%>
                        <li><a runat="server" href="#" data-toggle="dropdown" style="background-color: maroon" onload="LoggedInUser_Load">
                            <asp:Label ID="LoggedUSer" runat="server" Text="Jacob"></asp:Label>
                            <span class="badge badge-pill" style="background-color: maroon; border: 1.5px solid white">Logged In</span> <b class="caret"></b></a>
                            <ul class="dropdown-menu" id="LOG">
                                <li class="text-danger"><a runat="server" href="#" data-toggle="modal" data-target="#UserAccountInfo">
                                    <h5 class="text-danger glyphicon glyphicon-knight"><strong> Account-Info</strong></h5>
                                </a></li>
                                <li><a runat="server" href="#" data-toggle="modal" data-target="#UserLocked">
                                    <h5 class="text-danger glyphicon glyphicon-link"><strong> Lock</strong></h5>
                                </a></li>
                                <li><a runat="server" href="~/Default">
                                    <h5 class="text-danger glyphicon glyphicon-road"><strong> Log-Off </strong></h5>
                                    <asp:Label ID="UserLogged" CssClass="text-danger" runat="server" Text="Jacob"></asp:Label></a></li>
                                <li class="divider"></li>
                                <li><a runat="server" href="#" onclick="ExitZAFMC();" value="close">
                                    <h5 class="text-danger glyphicon glyphicon-signal"><strong> Exit</strong></h5>
                                </a></li>
                            </ul>
                            
                    </ul>
                </div>
            </div>
        </div>
        <%-- FOOTER --%>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p class="text-danger"><strong>&copy; <%: DateTime.Now.Year %> - ZAFMC </strong></p>
            </footer>
        </div>

        <%--MODAL FORM USER ACCOUNT LOCK (TIMEOUT)--%>
        <%-- JACOB JACOB JACOB JACOB JACOB --%>

        <div class="modal modal-wide  fade " id="UserLocked" tabindex="-1" role="dialog" aria-labelledby="LockedUserTitle" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-sm modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="UserAccLocked"><span class="text-danger"><strong></strong></span></h5>
                        <button type="button" class="close" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body ">
                        <div>
                            <h5 class="text-danger"><strong>ZAFMC - Currently Logged In User</strong></h5>
                            <hr />
                            <asp:Label ID="LUSER" runat="server" Font-Size="Small" Text="Logged In User" Font-Bold="True" CssClass="text-danger"></asp:Label>
                            <div class="input-group">
                                <i class="input-group-addon glyphicon glyphicon-user" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                <asp:TextBox ID="LogInUser" runat="server" ReadOnly="true" Height="30px" Width="155px" BorderStyle="Groove" MaxLength="20" CssClass="form-control text-uppercase" ToolTip="Logged User !!" BorderColor="Maroon"></asp:TextBox>
                            </div>
                            <asp:Label ID="Paswd" runat="server" Font-Size="Small" Text="Enter Password" Font-Bold="True" CssClass="text-danger"></asp:Label>
                            <div class="input-group">
                                <i class="input-group-addon glyphicon glyphicon-knight" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                <asp:TextBox ID="PassWD" runat="server" type="password" placeholder="Password..." Height="30px" MaxLength="20" Width="155px" BorderStyle="Groove" ViewStateMode="Disabled" CssClass="form-control" ToolTip="Your Password!!" BorderColor="Maroon"></asp:TextBox>

                            </div>

                        </div>
                    </div>
                    <div class="modal-footer">

                        <asp:LinkButton ID="UserLogIn" data-dismiss="modal" CssClass="text-danger" runat="server" ToolTip="Get back into the system.."><span class="glyphicon glyphicon-log-in pull-left "><strong> Log-In</strong></span>    </asp:LinkButton><asp:LinkButton ID="UserLogOff" data-dismiss="modal" CssClass="text-danger" OnLoad="LoggedUserAccount_Load" runat="server" ToolTip="Close System.."><span class="glyphicon glyphicon-tower pull-right"><strong> Exit</strong></span></asp:LinkButton>

                    </div>
                </div>
            </div>
        </div>
        <!--End Modal Form-->

        <%--MODAL FORM USER ACCOUNT-INFO (LOGIN)--%>
        <%-- JACOB JACOB JACOB JACOB JACOB --%>

        <div class="modal modal-wide  fade " id="UserAccountInfo" tabindex="-1" role="dialog" aria-labelledby="UserAccInfoTitle" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-md modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body ">
                        <div>
                            <h5 class="text-danger"><strong>ZAFMC - User Account Info</strong></h5>
                            <hr />
                            <%-- ScrollBars on Modal Form --%>
                            <div style="overflow-y: scroll; height: 420px; width: auto;">
                                <asp:Label ID="PassptID" runat="server" Font-Size="Small" Text="ID Number / Passport" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-road" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="PassportIdentity" runat="server" placeholder="ID Number.." ReadOnly="true" Height="30px" Width="144px" BorderStyle="Groove" MaxLength="20" ViewStateMode="Disabled" CssClass="form-control text-uppercase" ToolTip="ID Number / Passport !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <asp:Label ID="FNam" runat="server" Font-Size="Small" Text="Firstname" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-user" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="LogFirstname" runat="server" placeholder="Firstname.."  ReadOnly="true" Height="30px" Width="144px" BorderStyle="Groove" MaxLength="20" ViewStateMode="Disabled" CssClass="form-control text-capitalize" ToolTip="Firstname !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <asp:Label ID="SNam" runat="server" Font-Size="Small" Text="Surname" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-signal" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="LogSurname" runat="server" placeholder="Surname.." ReadOnly="true" Height="30px" Width="144px" BorderStyle="Groove" MaxLength="20" ViewStateMode="Disabled" CssClass="form-control text-capitalize" ToolTip="Surname !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <asp:Label ID="MobNm" runat="server" Font-Size="Small" Text="Mobile" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-phone" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="LogMobile" runat="server" placeholder="Mobile.." ReadOnly="true" Height="30px" Width="144px" BorderStyle="Groove" MaxLength="15" ViewStateMode="Disabled" CssClass="form-control text-capitalize" ToolTip="Mobile !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <asp:Label ID="LoMal" runat="server" Font-Size="Small" Text="Email" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-envelope" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="LogEmail" runat="server" placeholder="Email.." ReadOnly="true" Height="30px" Width="144px" BorderStyle="Groove" MaxLength="50" ViewStateMode="Disabled" CssClass="form-control" ToolTip="Email !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <asp:Label ID="RankPo" runat="server" Font-Size="Small" Text="Church Position" Font-Bold="True" CssClass="text-danger"></asp:Label>
                                <div class="input-group">
                                    <i class="input-group-addon glyphicon glyphicon-bishop" style="background-color: darkgrey; border-left-color: maroon; border-top-color: maroon; border-bottom-color: maroon"></i>
                                    <asp:TextBox ID="LogRankPost" runat="server" placeholder="Position.." Height="30px" Width="144px" ReadOnly="true" BorderStyle="Groove" MaxLength="20" ViewStateMode="Disabled" CssClass="form-control text-capitalize" ToolTip="Church Position !!" BorderColor="Maroon"></asp:TextBox>
                                </div>
                                <hr />
                                <h5 class="text-danger"><strong>User LogIn History</strong></h5>
                                <hr />

                                <%-- SQLDatasource to Bind data to Modal Form Grid View --%>
                                <asp:SqlDataSource ID="AccountInfoView" runat="server" ConnectionString="<%$ ConnectionStrings:ZionRegisterUser %>" SelectCommand="SELECT [LogInPassportID] as [Username],[LogInFirstname] as [Firstname],[LogInSurname] as [Surname],[LogInMacAddress] as [PC MacAddress],(REPLACE(convert(nvarchar,[LogInDateTime],106),'','/')) as [LoggedIn Date & Time] FROM .[LogIn] ORDER BY [LogInPassportID]"></asp:SqlDataSource>

                                <%-- Grid View User Log In History --%>
                                <asp:GridView ID="UserLogHistory" runat="server" ToolTip="User LogIn History..." CellPadding="4" ForeColor="#333333" GridLines="Both" DataSourceID="AccountInfoView" AllowPaging="True" ShowHeaderWhenEmpty="True">
                                    <%-- Insert Row Numbers --%>
                                    <Columns>
                                        <asp:TemplateField HeaderText="No." ItemStyle-Font-Bold="true" ItemStyle-ForeColor="Maroon" HeaderStyle-BackColor="White" HeaderStyle-ForeColor="Maroon">
                                            <ItemTemplate>
                                                <%# Container.DataItemIndex + 1 %>
                                            </ItemTemplate>
                                        </asp:TemplateField>
                                    </Columns>
                                    <%-- General Format (Table) --%>
                                    <FooterStyle BackColor="#FFFFCC" ForeColor="#330099" />
                                    <HeaderStyle BackColor="#990000" Font-Bold="True" ForeColor="#FFFFCC" Wrap="false" Height="25px" />
                                    <PagerStyle BackColor="#FFFFCC" ForeColor="#330099" HorizontalAlign="Center" />
                                    <RowStyle BackColor="White" ForeColor="#330099" Height="20px" Width="150px" Wrap="false" BorderColor="Maroon" />
                                    <SelectedRowStyle BackColor="#FFCC66" Font-Bold="True" ForeColor="#663399" />
                                    <SortedAscendingCellStyle BackColor="#FEFCEB" />
                                    <SortedAscendingHeaderStyle BackColor="#AF0101" />
                                    <SortedDescendingCellStyle BackColor="#F6F0C0" />
                                    <SortedDescendingHeaderStyle BackColor="#7E0000" />
                                </asp:GridView>

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">

                        <asp:LinkButton ID="UserAccInfo" data-dismiss="modal" CssClass="text-danger" runat="server" ToolTip="Close Account-Info.."><span class="glyphicon glyphicon-wrench"><strong> Close</strong></span> </asp:LinkButton>

                    </div>
                </div>
            </div>
        </div>

        <!--End Modal Form-->
    </form>

</body>
</html>
