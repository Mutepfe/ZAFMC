@model ZAFMC.Models.Contact

@{
    ViewBag.Title = "Index";
}

    <asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
        <br />
        <br />

        <div class="container">
            <div class="row">

                <div class="col-md-3">
                    <asp:Panel ID="ContactsOne" runat="server" BorderStyle="None" Height="400px" ScrollBars="Auto" ToolTip="Capture details.." CssClass="form-control" ViewStateMode="Disabled" BorderColor="Maroon">

                        <asp:Label ID="NS" runat="server" Text="Name and Surname" CssClass="text-danger" Font-Bold="True" Font-Size="Small"></asp:Label><br />
                        <asp:DropDownList ID="NameSurname" runat="server" CssClass="form-control" Height="32px" Width="170px" ToolTip="High Six(6) Only..!!">
                            <asp:ListItem>High Six..</asp:ListItem>
                            <asp:ListItem>Bishop Ezra Shoko</asp:ListItem>
                            <asp:ListItem>Mr. J. Muzangwa</asp:ListItem>
                            <asp:ListItem>Mr. TKS. Mawisire </asp:ListItem>
                            <asp:ListItem>Mr. J. Matongo </asp:ListItem>
                            <asp:ListItem>Mr. P. Penengwa </asp:ListItem>
                            <asp:ListItem>Mr. J. Chidanga </asp:ListItem>
                        </asp:DropDownList>
                        <asp:Label ID="RP" runat="server" CssClass="text-danger" Font-Bold="True" Font-Size="Small" Text="Rank / Position"></asp:Label><br />
                        <asp:DropDownList ID="RankPost" runat="server" CssClass="form-control" Height="32px" Width="170px" ToolTip="Post..!!">
                            <asp:ListItem>Select..</asp:ListItem>
                            <asp:ListItem>Bishop</asp:ListItem>
                            <asp:ListItem>Vice-Bishop</asp:ListItem>
                            <asp:ListItem>Senior High Priest</asp:ListItem>
                            <asp:ListItem>High Priest (1)</asp:ListItem>
                            <asp:ListItem>High Priest (2) </asp:ListItem>
                            <asp:ListItem>High Priest (3)</asp:ListItem>
                        </asp:DropDownList>
                        <asp:Label ID="MN" runat="server" CssClass="text-danger" Font-Bold="True" Font-Size="Small" Text="Mobile Number"></asp:Label><br />
                        <asp:TextBox ID="MobileNumber" runat="server" placeholder="Cell.." BorderColor="Maroon" CssClass="form-control text-capitalize" Height="29px" MaxLength="15" Width="170px"></asp:TextBox>
                        <asp:Label ID="EA" runat="server" CssClass="text-danger" Font-Bold="True" Font-Size="Small" Text="Email Address"></asp:Label><br />
                        <asp:TextBox ID="EmailAddress" runat="server" placeholder="Mail.." CssClass="form-control text-uppercase" Font-Bold="True" Font-Size="Small" Height="29px" TextMode="SingleLine" Width="170px" BorderColor="Maroon"></asp:TextBox>
                        <asp:Label ID="PA" runat="server" CssClass="text-danger" Font-Bold="True" Font-Size="Small" Text="Physical Address"></asp:Label><br />
                        <asp:TextBox ID="PhysicalAddress" runat="server" placeholder="Home Address.." BorderColor="Maroon" CssClass="form-control text-capitalize" TextMode="MultiLine" Height="100px" MaxLength="80" Width="170px"></asp:TextBox><br />
                    </asp:Panel>
                </div>
                <div class="col-md-9">
                    <asp:Panel ID="ContactsTwo" runat="server" BorderStyle="Groove" Height="530px" ScrollBars="Auto" ToolTip="Capture details.." CssClass="form-control" ViewStateMode="Disabled" BorderColor="Maroon">
                        <asp:Label ID="HSx" runat="server" Text="ZAFMC - High Six (6) Contacts" CssClass="text-danger" Font-Bold="True" Font-Size="Small"></asp:Label>
                        <br />
                        <br />
                        <asp:GridView ID="HighSix" runat="server" AutoGenerateColumns="False" BackColor="White" BorderColor="#CC9966" BorderStyle="None" BorderWidth="1px" CellPadding="4" DataSourceID="HighSixContacts" Height="209px" Width="741px">
                            <Columns>
                                <asp:BoundField DataField="ContactName" HeaderText="Name" SortExpression="ContactName" />
                                <asp:BoundField DataField="ContactPosition" HeaderText="Position" SortExpression="ContactPosition" />
                                <asp:BoundField DataField="ContactMail" HeaderText="Email" SortExpression="ContactMail" />
                                <asp:BoundField DataField="ContactAddress" HeaderText="Address" SortExpression="ContactAddress" />
                            </Columns>
                            <FooterStyle BackColor="#FFFFCC" ForeColor="#330099" />
                            <HeaderStyle BackColor="#990000" Font-Bold="True" ForeColor="#FFFFCC" />
                            <PagerStyle BackColor="#FFFFCC" ForeColor="#330099" HorizontalAlign="Center" />
                            <RowStyle BackColor="White" ForeColor="#330099" />
                            <SelectedRowStyle BackColor="#FFCC66" Font-Bold="True" ForeColor="#663399" />
                            <SortedAscendingCellStyle BackColor="#FEFCEB" />
                            <SortedAscendingHeaderStyle BackColor="#AF0101" />
                            <SortedDescendingCellStyle BackColor="#F6F0C0" />
                            <SortedDescendingHeaderStyle BackColor="#7E0000" />
                        </asp:GridView>
                        <asp:SqlDataSource ID="HighSixContacts" runat="server" ConnectionString="<%$ ConnectionStrings:ZIONHighSix %>" SelectCommand="SELECT [ContactName], [ContactPosition], [ContactMail], [ContactAddress] FROM [Contact]"></asp:SqlDataSource>
                        <br />
                        <br />

                        <address class="text-danger">
                            <strong>
                                ZAFMC HQ <br />
                                P.O. Box 4, <br />
                                Chivi, <br />
                                Masvingo, <br />
                                Zimbabwe. <br />
                                +263(773)659 180 <br />
                                info@zafmc.co.zw <br />
                                www.zafmc.org.zw
                            </strong>
                        </address>
                        <br />
                        <br />
                    </asp:Panel>
                </div>

            </div>
        </div>


        <br />

    </asp:Content>

